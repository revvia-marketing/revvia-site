---
/**
 * Hidden ad-attribution inputs for any Netlify form. Netlify only stores
 * fields that exist in the built HTML, so every lead form renders these.
 * Filled on submit by fillAttribution() / window.rvTrack.fill(form).
 * The Lead Ledger sheet and the Meta Conversions API read these values.
 */
---
<input type="hidden" name="fbclid" />
<input type="hidden" name="gclid" />
<input type="hidden" name="gbraid" />
<input type="hidden" name="wbraid" />
<input type="hidden" name="fbc" />
<input type="hidden" name="fbp" />
<input type="hidden" name="utm_source" />
<input type="hidden" name="utm_medium" />
<input type="hidden" name="utm_campaign" />
<input type="hidden" name="utm_content" />
<input type="hidden" name="utm_term" />
<input type="hidden" name="landing_url" />
<input type="hidden" name="first_landing" />
<input type="hidden" name="traffic_referrer" />
<input type="hidden" name="event_id" />
