---
/**
 * Signature element: an ILLUSTRATIVE (not live) example of an AI answer that
 * names three competitors and omits the reader's business. Types the query,
 * then reveals four result rows. Reduced-motion renders it all immediately.
 */
---
<div
  class="answer"
  role="img"
  aria-label="Illustrative example: an AI answer names three competitors and does not mention your business. This is a sample, not live data."
>
  <div class="answer-bar">
    <i class="dot" aria-hidden="true"></i><i class="dot" aria-hidden="true"></i><i class="dot" aria-hidden="true"></i>
    <span>AI answer &middot; illustrative example</span>
  </div>
  <div class="answer-body">
    <div class="answer-q" id="aiv-q">&nbsp;</div>
    <div class="result" data-r>
      <div class="r-num">01</div>
      <div><div class="r-name">Competitor A</div><div class="r-why">Named first. Cited for emergency response times.</div></div>
    </div>
    <div class="result" data-r>
      <div class="r-num">02</div>
      <div><div class="r-name">Competitor B</div><div class="r-why">Named for water heater and repipe work.</div></div>
    </div>
    <div class="result" data-r>
      <div class="r-num">03</div>
      <div><div class="r-name">Competitor C</div><div class="r-why">Named for licensing and warranty coverage.</div></div>
    </div>
    <div class="result result-you" data-r>
      <div class="r-num">-</div>
      <div><div class="r-name">Your company</div><div class="r-why">Not mentioned in this example.</div></div>
    </div>
  </div>
</div>

<style>
  .answer { background: var(--card); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45); }
  .answer-bar { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-bottom: 1px solid var(--line); background: rgba(0, 0, 0, 0.25); }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--line-2); }
  .answer-bar span { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted-2); margin-left: auto; }
  .answer-body { padding: 22px; }
  .answer-q { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 14px; color: #fff; border-left: 3px solid var(--gold); padding-left: 12px; margin-bottom: 22px; min-height: 44px; }
  .caret { display: inline-block; width: 8px; background: var(--gold); color: transparent; animation: aiv-blink 1s steps(1) infinite; }
  @keyframes aiv-blink { 50% { opacity: 0; } }
  .result { display: flex; gap: 14px; align-items: flex-start; padding: 13px 0; border-top: 1px solid var(--line); opacity: 0; transform: translateY(6px); }
  .result.is-in { opacity: 1; transform: none; transition: opacity 0.45s ease, transform 0.45s ease; }
  .r-num { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12px; font-weight: 600; color: var(--gold); padding-top: 3px; min-width: 22px; }
  .r-name { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 700; font-size: 20px; color: #fff; line-height: 1.1; }
  .r-why { font-size: 13px; color: var(--muted); margin-top: 3px; }
  /* "missing" row: greyed + dashed = absent, not a new red (no danger token) */
  .result-you { border: 1px dashed var(--line-2); border-radius: 10px; background: var(--bg-2); padding: 13px 12px; margin-top: 8px; }
  .result-you .r-num, .result-you .r-name { color: var(--muted); }
  .result-you .r-why { color: var(--muted-2); }
  @media (prefers-reduced-motion: reduce) {
    .result { opacity: 1; transform: none; }
    .caret { animation: none; }
  }
</style>

<script is:inline>
  (() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const qEl = document.getElementById('aiv-q');
    const rows = document.querySelectorAll('[data-r]');
    const text = 'Who is the best plumber in Carlsbad?';
    if (!qEl) return;
    const showRows = (start) => rows.forEach((r, i) => setTimeout(() => r.classList.add('is-in'), start + i * 380));
    if (reduce) {
      qEl.textContent = text;
      rows.forEach((r) => r.classList.add('is-in'));
      return;
    }
    let i = 0;
    qEl.innerHTML = '<span class="caret">|</span>';
    const timer = setInterval(() => {
      i++;
      qEl.innerHTML = text.slice(0, i) + '<span class="caret">|</span>';
      if (i >= text.length) { clearInterval(timer); showRows(600); }
    }, 42);
  })();
</script>
