---
const steps = [
  { n: '1', h: 'You request the audit', p: 'Business name, city, and trade. That is enough for us to start. No site access, no call, no credit card.' },
  { n: '2', h: 'We send the summary', p: 'A short written summary of what the AI engines say about your trade in your city, and where you stand in it. It arrives by email.' },
  { n: '3', h: 'We walk through the full picture', p: 'If you want the complete breakdown and what it would take to fix it, that costs a thirty minute meeting. Nothing else.' },
];
---
<section class="psec bg2">
  <div class="wrap">
    <div class="eyebrow blk">How it works</div>
    <h2 class="sec">Three steps. One meeting.</h2>
    <div class="steps">
      {steps.map((s) => (
        <div class="step">
          <span class="step-n grad-text">{s.n}</span>
          <h3>{s.h}</h3>
          <p>{s.p}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; margin-top: 14px; }
  .step-n { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 62px; line-height: 1; display: block; margin-bottom: 8px; }
  .step h3 { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 700; font-size: 21px; color: #fff; margin-bottom: 8px; }
  .step p { color: var(--muted); font-size: 15px; margin: 0; }
  @media (max-width: 900px) { .steps { grid-template-columns: 1fr; gap: 26px; } }
</style>
