---
/**
 * Eyebrow + H2 + three problem cards (icon, bold line, one sentence).
 * Icons are inline SVG (aria-hidden) chosen by `card.icon`.
 */
interface Card { icon?: string; bold: string; text: string; }
interface Props { eyebrow: string; heading: string; cards: Card[]; tone?: 'base' | 'alt'; }
const { eyebrow, heading, cards, tone = 'base' } = Astro.props;

const ICONS: Record<string, string> = {
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 20c0-3.5 3.6-6 8-6s8 2.5 8 6"/>',
  plan: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/>',
  spark: '<path d="M12 3l2.1 5.9L20 11l-5.9 2.1L12 19l-2.1-5.9L4 11l5.9-2.1z"/>',
  eye: '<path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6z"/><circle cx="12" cy="12" r="2.5"/>',
  users: '<circle cx="9" cy="8" r="3.2"/><path d="M2.5 19c0-3 2.9-5 6.5-5s6.5 2 6.5 5"/><path d="M16 5.5a3 3 0 0 1 0 5.8M21 19c0-2.3-1.6-4-4-4.6"/>',
  search: '<circle cx="11" cy="11" r="6"/><path d="M20 20l-4.3-4.3"/>',
  split: '<path d="M6 3v4a4 4 0 0 0 4 4h4a4 4 0 0 1 4 4v4M6 21v-4"/><circle cx="6" cy="4" r="1.6"/><circle cx="18" cy="20" r="1.6"/>',
  bolt: '<path d="M13 2L4 14h6l-1 8 9-12h-6z"/>',
};
function icon(name?: string) { return ICONS[name || 'spark'] || ICONS.spark; }
---
<section class:list={['lp-section', { alt: tone === 'alt' }]}>
  <div class="lp-wrap">
    <div class="lp-sec-head">
      <div class="eyebrow">{eyebrow}</div>
      <h2>{heading}</h2>
    </div>
    <div class="pc-grid">
      {cards.map((c) => (
        <div class="pc-card">
          <span class="pc-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={icon(c.icon)} />
          </span>
          <p class="pc-bold">{c.bold}</p>
          <p class="pc-text">{c.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .pc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .pc-card { background: var(--card); border: 1px solid var(--line-2); border-radius: 14px; padding: 26px 24px; }
  .pc-icon {
    display: inline-flex; width: 44px; height: 44px; border-radius: 11px; align-items: center; justify-content: center;
    background: linear-gradient(135deg, rgba(138,15,173,0.18), rgba(254,156,28,0.18));
    border: 1px solid var(--line-2); margin-bottom: 16px;
  }
  .pc-icon svg { width: 22px; height: 22px; color: #fff; }
  .pc-bold { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 700; font-size: 18px; color: #fff; margin-bottom: 8px; line-height: 1.25; }
  .pc-text { color: var(--muted); font-size: 15.5px; line-height: 1.55; }
  @media (max-width: 768px) { .pc-grid { grid-template-columns: 1fr; gap: 14px; } }
</style>
