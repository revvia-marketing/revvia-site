---
/**
 * Closing gradient-border band. The button scrolls to the single form/quiz
 * (`target` is "#form" or "#scorecard"); data-cta is handled by LandingLayout
 * (smooth scroll + focus the first field).
 */
interface Props { heading: string; lead?: string; buttonLabel: string; target?: string; tone?: 'base' | 'alt'; }
const { heading, lead, buttonLabel, target = '#form', tone = 'base' } = Astro.props;
---
<section class:list={['lp-section', { alt: tone === 'alt' }]}>
  <div class="lp-wrap">
    <div class="fcta">
      <h2>{heading}</h2>
      {lead && <p>{lead}</p>}
      <a class="fcta-btn" href={target} data-cta>{buttonLabel}</a>
    </div>
  </div>
</section>

<style>
  .fcta {
    text-align: center; border: 1px solid transparent; border-radius: 20px; padding: 48px 32px;
    background: linear-gradient(var(--card), var(--card)) padding-box, var(--grad) border-box;
  }
  .fcta h2 {
    font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; letter-spacing: -0.02em;
    font-size: clamp(26px, 4vw, 40px); line-height: 1.1; color: #fff;
  }
  .fcta p { color: var(--muted); font-size: 17px; margin: 14px auto 0; max-width: 540px; }
  .fcta-btn {
    display: inline-block; margin-top: 26px; background: var(--grad); color: #fff; border-radius: 10px;
    padding: 15px 30px; font: 600 16px Inter, system-ui, sans-serif; transition: transform 0.15s;
  }
  .fcta-btn:hover { transform: translateY(-2px); }
</style>
