---
/**
 * The verified result tiles from the homepage "Proof, not promises" section,
 * word for word (from src/lib/proof.ts). Each tile links to its case study in
 * a new tab. `include` picks which tiles and in what order (by case slug).
 */
import { resultTiles } from '../../lib/proof';
interface Props { heading: string; include: string[]; tone?: 'base' | 'alt'; }
const { heading, include, tone = 'base' } = Astro.props;
const tiles = resultTiles(include);
---
<section class:list={['lp-section', { alt: tone === 'alt' }]}>
  <div class="lp-wrap">
    <div class="lp-sec-head">
      <div class="eyebrow">The work</div>
      <h2>{heading}</h2>
    </div>
    <div class="ps-grid">
      {tiles.map((t) => (
        <a class="ps-tile" href={t.href} target="_blank" rel="noopener">
          <div class="ps-stat grad-text num">{t.stat}</div>
          <div class="ps-label">{t.label}</div>
          <div class="ps-name">{t.name} <span aria-hidden="true">↗</span></div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .ps-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .ps-tile {
    display: flex; flex-direction: column; background: var(--card); border: 1px solid var(--line-2);
    border-radius: 14px; padding: 24px 22px; transition: transform 0.16s, border-color 0.16s;
  }
  .ps-tile:hover { transform: translateY(-3px); border-color: var(--m); }
  .ps-stat { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: clamp(26px, 3.4vw, 36px); line-height: 1; }
  .ps-label { color: var(--muted); font-size: 14px; line-height: 1.5; margin: 12px 0 16px; flex: 1; }
  .ps-name { font-size: 13px; font-weight: 600; color: #fff; margin-top: auto; }
  .ps-name span { color: var(--m); }
  @media (max-width: 900px) { .ps-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .ps-grid { grid-template-columns: 1fr; } }
</style>
