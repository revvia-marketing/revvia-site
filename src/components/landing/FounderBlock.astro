---
/**
 * Founder block (same on all three landing pages). Copy is approved in the
 * build brief. Photo is the public /tim-holt.jpg (explicit dimensions, lazy).
 */
interface Props { tone?: 'base' | 'alt'; }
const { tone = 'alt' } = Astro.props;
const chips = [
  'Revenue over impressions',
  'Senior-led',
  'In person in San Diego',
  'Month to month',
  'Honest on the first call',
];
---
<section class:list={['lp-section', { alt: tone === 'alt' }]}>
  <div class="lp-wrap">
    <div class="fb">
      <figure class="fb-photo">
        <img src="/tim-holt.jpg" alt="Tim Holt, founder and CEO of Revvia" width="720" height="900" loading="lazy" decoding="async" />
      </figure>
      <div class="fb-body">
        <h2>You work with the founder. Not a junior.</h2>
        <p>I'm Tim Holt. I started Revvia in North County after years as a pastor, and I still run it the same way: be honest, show up, and do the work. You get me on your account, a senior team that shoots everything in-house, and month-to-month terms. If we're not a fit, I'll tell you on the first call.</p>
        <p class="fb-sig">Tim Holt &middot; Founder &amp; CEO &middot; Carlsbad, CA</p>
        <ul class="fb-chips">
          {chips.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .fb { display: grid; grid-template-columns: 300px 1fr; gap: 40px; align-items: center; max-width: 900px; margin: 0 auto; }
  .fb-photo { margin: 0; border-radius: 16px; overflow: hidden; border: 1px solid var(--line-2); background: var(--bg-2); }
  .fb-photo img { width: 100%; height: auto; display: block; }
  .fb-body h2 { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; letter-spacing: -0.02em; font-size: clamp(24px, 3.4vw, 34px); line-height: 1.1; color: #fff; }
  .fb-body p { color: #d7dae2; font-size: 17px; line-height: 1.7; margin-top: 16px; }
  .fb-sig { color: var(--muted) !important; font-size: 14px !important; }
  .fb-chips { list-style: none; display: flex; flex-wrap: wrap; gap: 9px; margin-top: 20px; padding: 0; }
  .fb-chips li {
    font-size: 13px; color: var(--muted); border: 1px solid var(--line-2); border-radius: 999px; padding: 7px 14px;
  }
  @media (max-width: 760px) {
    .fb { grid-template-columns: 1fr; gap: 24px; }
    .fb-photo { max-width: 240px; }
  }
</style>
