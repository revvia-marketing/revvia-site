---
/**
 * "Show the thing": a labeled visual mock of the asset (left) + a "What you'll
 * get" list and CTA (right). variant = guide | scorecard | snapshot. Every mock
 * is clearly labeled Example/Preview. Built in HTML/CSS - no images.
 */
interface Props {
  variant: 'guide' | 'scorecard' | 'snapshot';
  heading?: string;
  bullets: string[];
  buttonLabel: string;
  buttonTarget?: string;
  tone?: 'base' | 'alt';
}
const { variant, heading = "What you'll get", bullets, buttonLabel, buttonTarget = '#form', tone = 'base' } = Astro.props;

const scoreBars = [
  { label: 'Leadership', v: 2 },
  { label: 'Tracking', v: 1 },
  { label: 'Channels', v: 2 },
  { label: 'Content & Brand', v: 3 },
  { label: 'Follow-up & Visibility', v: 1 },
];
---
<section class:list={['lp-section', { alt: tone === 'alt' }]}>
  <div class="lp-wrap ap">
    <div class="ap-mock">
      {variant === 'guide' && (
        <div class="g-stack" role="img" aria-label="Preview of the guide: three sections - Option A Hire full-time, Option B Hire an agency, Option C Fractional CMO.">
          <span class="ap-badge">Preview</span>
          <div class="g-card g-back2"><span class="g-kicker">Option C</span><span class="g-title">Fractional CMO</span></div>
          <div class="g-card g-back1"><span class="g-kicker">Option B</span><span class="g-title">Hire an agency</span></div>
          <div class="g-card g-front">
            <span class="g-kicker">Option A</span><span class="g-title">Hire full-time</span>
            <div class="g-table">
              <div class="g-th"><span>Annual revenue</span><span>Our recommendation</span></div>
              <div class="g-tr"><span>$1M – $5M</span><span>Fractional CMO</span></div>
              <div class="g-tr"><span>$5M – $20M</span><span>Fractional + coordinator</span></div>
            </div>
          </div>
        </div>
      )}

      {variant === 'scorecard' && (
        <div class="sc-mock" role="img" aria-label="Example scorecard result: 9 out of 20, Building the Engine, with five category bars.">
          <span class="ap-badge">Example result</span>
          <div class="sc-top">
            <div class="sc-ring"><span class="sc-ring-num">9</span><span class="sc-ring-of">/20</span></div>
            <div><div class="sc-tier">Building the Engine</div><div class="sc-tier-sub">You've got real pieces in place.</div></div>
          </div>
          <div class="sc-bars">
            {scoreBars.map((b) => (
              <div class="sc-bar">
                <span class="sc-bar-l">{b.label}</span>
                <span class="sc-bar-track"><span class="sc-bar-fill" style={`width:${(b.v / 4) * 100}%`}></span></span>
                <span class="sc-bar-v">{b.v}/4</span>
              </div>
            ))}
          </div>
        </div>
      )}

      {variant === 'snapshot' && (
        <div class="sn-mock" role="img" aria-label="Example AI Visibility Snapshot comparing your business with two competitors across ChatGPT and Google AI Mode.">
          <div class="sn-head"><span>AI Visibility Snapshot — Example</span></div>
          <div class="sn-prompt">"Best kitchen remodeler in Carlsbad?"</div>
          <div class="sn-table">
            <div class="sn-th"><span>Business</span><span>ChatGPT</span><span>Google AI Mode</span></div>
            <div class="sn-tr sn-you"><span>Your business</span><span class="sn-no">—</span><span class="sn-no">—</span></div>
            <div class="sn-tr"><span>Competitor A</span><span class="sn-yes">Mentioned</span><span class="sn-yes">Mentioned</span></div>
            <div class="sn-tr"><span>Competitor B</span><span class="sn-yes">Mentioned</span><span class="sn-no">—</span></div>
          </div>
          <div class="sn-fixes">
            <div class="sn-fixes-h">Top 3 fixes</div>
            <div class="sn-blur"></div><div class="sn-blur"></div><div class="sn-blur short"></div>
          </div>
          <p class="sn-note">Example. Your snapshot uses your real competitors.</p>
        </div>
      )}
    </div>

    <div class="ap-body">
      <h2>{heading}</h2>
      <ul class="ap-bullets">
        {bullets.map((b) => <li>{b}</li>)}
      </ul>
      <a class="ap-btn" href={buttonTarget} data-cta>{buttonLabel}</a>
    </div>
  </div>
</section>

<style>
  .ap { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .ap-mock { position: relative; min-height: 300px; display: flex; align-items: center; justify-content: center; }
  .ap-badge {
    position: absolute; top: 0; right: 0; z-index: 5; font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    color: #fff; background: var(--grad); border-radius: 999px; padding: 5px 12px;
  }
  .ap-body h2 { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; letter-spacing: -0.02em; font-size: clamp(24px, 3.2vw, 32px); color: #fff; }
  .ap-bullets { list-style: none; margin: 22px 0 28px; padding: 0; display: grid; gap: 13px; }
  .ap-bullets li { color: #e6e8ee; font-size: 16px; line-height: 1.5; padding-left: 28px; position: relative; }
  .ap-bullets li::before { content: ""; position: absolute; left: 0; top: 7px; width: 13px; height: 13px; border-radius: 4px; background: var(--grad); }
  .ap-btn { display: inline-block; background: var(--grad); color: #fff; border-radius: 10px; padding: 14px 26px; font: 600 16px Inter, system-ui, sans-serif; transition: transform 0.15s; }
  .ap-btn:hover { transform: translateY(-2px); }

  /* --- guide stack --- */
  .g-stack { position: relative; width: 300px; height: 300px; }
  .g-card { position: absolute; width: 240px; border: 1px solid var(--line-2); border-radius: 14px; background: var(--card); padding: 22px; }
  .g-kicker { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--m); font-weight: 700; display: block; }
  .g-title { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 700; font-size: 19px; color: #fff; display: block; margin-top: 6px; }
  .g-back2 { top: 8px; left: 46px; transform: rotate(6deg); opacity: 0.7; }
  .g-back1 { top: 26px; left: 28px; transform: rotate(-3deg); opacity: 0.85; }
  .g-front { top: 50px; left: 6px; box-shadow: 0 20px 50px rgba(0,0,0,0.45); }
  .g-table { margin-top: 16px; border-top: 1px solid var(--line); }
  .g-th, .g-tr { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; padding: 9px 0; border-bottom: 1px solid var(--line); font-size: 11.5px; }
  .g-th span { color: var(--muted-2); text-transform: uppercase; letter-spacing: 0.04em; font-weight: 700; font-size: 10px; }
  .g-tr span { color: #d7dae2; }
  .g-tr span:first-child { color: #fff; font-weight: 600; }

  /* --- scorecard demo --- */
  .sc-mock { width: 100%; max-width: 380px; background: var(--card); border: 1px solid var(--line-2); border-radius: 16px; padding: 26px; position: relative; }
  .sc-top { display: flex; gap: 18px; align-items: center; margin-bottom: 20px; }
  .sc-ring { flex: 0 0 auto; width: 92px; height: 92px; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; background: conic-gradient(from 200deg, #8a0fad, #d6248f, #ec4f65, #fe9c1c, #8a0fad); }
  .sc-ring::before { content: ""; position: absolute; inset: 5px; border-radius: 50%; background: var(--card); }
  .sc-ring-num { position: relative; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 32px; color: #fff; line-height: 1; }
  .sc-ring-of { position: relative; color: var(--muted); font-size: 12px; }
  .sc-tier { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 700; font-size: 18px; color: #fff; }
  .sc-tier-sub { color: var(--muted); font-size: 13px; margin-top: 3px; }
  .sc-bars { display: grid; gap: 10px; }
  .sc-bar { display: grid; grid-template-columns: 1fr 70px 30px; gap: 10px; align-items: center; font-size: 12px; }
  .sc-bar-l { color: #d7dae2; }
  .sc-bar-track { height: 8px; background: var(--line); border-radius: 99px; overflow: hidden; }
  .sc-bar-fill { display: block; height: 100%; background: var(--grad); border-radius: 99px; }
  .sc-bar-v { color: var(--muted); text-align: right; }

  /* --- snapshot demo --- */
  .sn-mock { width: 100%; max-width: 420px; background: var(--card); border: 1px solid var(--line-2); border-radius: 16px; padding: 22px; }
  .sn-head { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 700; font-size: 14px; color: #fff; }
  .sn-prompt { margin: 12px 0 14px; background: var(--bg-2); border: 1px solid var(--line); border-radius: 10px; padding: 11px 14px; color: #d7dae2; font-size: 14px; }
  .sn-table { border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
  .sn-th, .sn-tr { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 6px; padding: 10px 12px; font-size: 12.5px; align-items: center; }
  .sn-th { background: var(--bg-2); color: var(--muted-2); text-transform: uppercase; letter-spacing: 0.04em; font-weight: 700; font-size: 10.5px; }
  .sn-tr { border-top: 1px solid var(--line); color: #d7dae2; }
  .sn-tr span:first-child { color: #fff; font-weight: 600; }
  .sn-you { background: rgba(214,36,143,0.06); }
  .sn-yes { color: #7bdfa0; font-weight: 600; }
  .sn-no { color: var(--muted-2); }
  .sn-fixes { margin-top: 14px; }
  .sn-fixes-h { font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--m); font-weight: 700; margin-bottom: 9px; }
  .sn-blur { height: 10px; border-radius: 6px; background: linear-gradient(90deg, var(--line-2), var(--line)); margin-bottom: 8px; filter: blur(2px); opacity: 0.8; }
  .sn-blur.short { width: 60%; }
  .sn-note { margin-top: 12px; color: var(--muted-2); font-size: 12px; font-style: italic; }

  @media (max-width: 860px) {
    .ap { grid-template-columns: 1fr; gap: 32px; }
    .ap-mock { min-height: auto; }
    .g-stack { margin: 10px auto 24px; }
  }
</style>
