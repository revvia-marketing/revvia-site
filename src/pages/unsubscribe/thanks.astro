---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Unsubscribed"
  description="We'll stop follow-up emails to that address."
  path="/unsubscribe/thanks"
  noindex={true}
>
  <section class="page-hero">
    <div class="page-hero-in" style="max-width:720px">
      <h1>Got it.</h1>
      <p class="sub">We'll stop follow-up emails to that address.</p>
      <p><a href="/">Back to Revvia</a></p>
    </div>
  </section>
</BaseLayout>
