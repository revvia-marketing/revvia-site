---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Request received"
  description="Your AI visibility audit request is in. We'll email your summary within two business days."
  path="/ai-visibility/thanks"
  noindex={true}
>
  <section class="page-hero">
    <div class="page-hero-in" style="max-width:720px">
      <div class="eyebrow">AI Visibility</div>
      <h1>Request received.</h1>
      <p class="sub">Your audit is in. We'll email your AI visibility summary within two business days - whether the news is good or bad. Keep an eye on your inbox.</p>
      <a class="btn btn-lg" href="/">Back to the homepage</a>
    </div>
  </section>
</BaseLayout>
