---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Intake received"
  description="Your AI Visibility intake is in."
  path="/ai-visibility/intake/thanks"
  noindex={true}
>
  <section class="page-hero">
    <div class="page-hero-in" style="max-width:720px">
      <h1>Got it. Your intake is in.</h1>
      <p class="sub">The clock starts when we have your completed intake form and manager access. If everything on the setup list isn't delivered by day 21, email us and we refund your setup fee in full. This covers our work, not what AI assistants say.</p>
      <p class="sub">If your setup was waived through the founding offer, there's no setup fee to refund.</p>
      <p><a href="/ai-visibility/">Back to Revvia AI Visibility</a></p>
    </div>
  </section>
</BaseLayout>
