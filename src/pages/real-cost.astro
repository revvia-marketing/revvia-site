---
import LandingLayout from '../layouts/LandingLayout.astro';
import LogoStrip from '../components/landing/LogoStrip.astro';
import ProblemCards from '../components/landing/ProblemCards.astro';
import AssetPreview from '../components/landing/AssetPreview.astro';
import CompareTable from '../components/landing/CompareTable.astro';
import HowItWorks from '../components/landing/HowItWorks.astro';
import ProofStats from '../components/landing/ProofStats.astro';
import Testimonials from '../components/landing/Testimonials.astro';
import FounderBlock from '../components/landing/FounderBlock.astro';
import FAQ from '../components/landing/FAQ.astro';
import FinalCTA from '../components/landing/FinalCTA.astro';
import StickyMobileCTA from '../components/landing/StickyMobileCTA.astro';
import FormReassurance from '../components/landing/FormReassurance.astro';
import type { FaqItem } from '../lib/schema';

const revenueOptions = ['Under $350K', '$350K - $1M', '$1M - $5M', '$5M - $20M', '$20M+'];

const faqs: FaqItem[] = [
  { question: 'Is the guide really free?', answer: 'Yes. Fill out the form and you can read it right away.' },
  { question: 'Is this a sales pitch?', answer: 'No. It compares all three options honestly, including when a fractional CMO is the wrong fit.' },
  { question: "What's a fractional CMO?", answer: 'A senior marketing leader who works with you part-time. With Revvia, the same team also does the work: ads, content, video, SEO and more.' },
  { question: 'How is that different from an agency?', answer: 'Most agencies run one channel and wait for you to tell them what to do. A fractional CMO owns the plan and the results.' },
  { question: 'Why do you ask for revenue?', answer: 'So we only follow up with info that fits your stage. We never share it.' },
  { question: 'Do you only work in San Diego?', answer: "We're based in Carlsbad and work in person across San Diego County and Southern California." },
];
---
<LandingLayout
  title="The Real Cost of Marketing Help in San Diego"
  description="Free guide: a hire, an agency, or a fractional CMO - what each really costs in San Diego, what you get, and how to tell which one your business needs right now."
  path="/real-cost"
>
  <section class="lp">
    <div class="lp-grid">
      <div class="lp-copy">
        <p class="eyebrow">Free guide for San Diego business owners</p>
        <h1>You need marketing help. <span class="grad-text">Which kind?</span></h1>
        <p class="sub">A full-time hire, an agency, or a fractional CMO. Here's what each one really costs in San Diego, what you actually get, and how to tell which one your business needs right now.</p>

        <div class="inside">
          <p class="inside-h">What's inside</p>
          <ul>
            <li>The fully loaded cost of a San Diego marketing hire, using federal wage data</li>
            <li>What agencies usually do (and the part they usually don't)</li>
            <li>What a fractional CMO is, and when it's the smarter move</li>
            <li>A one-page decision guide: which option fits your stage</li>
          </ul>
        </div>

        <a class="hero-cta-mobile" href="#form" data-cta>Get the guide →</a>

        <div class="trust">
          <span>Founder-led</span>
          <span>In person in San Diego</span>
          <span>Month to month, no long-term contracts</span>
        </div>

        <div class="hero-proof">
          <Testimonials include={['Sam Dobel']} layout="single" />
        </div>

        <div class="who">
          <p><strong>Who's behind this.</strong> Revvia is a San Diego growth studio that runs strategy and execution for businesses too big for a freelancer and too small for the national agencies. <a href="/about" target="_blank" rel="noopener">More about Revvia ↗</a></p>
        </div>
      </div>

      <div class="lp-formcol" id="form">
        <form
          id="real-cost-form"
          class="lp-form"
          name="real-cost-guide"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action="/real-cost/thanks"
        >
          <input type="hidden" name="form-name" value="real-cost-guide" />
          <p class="hp" hidden><label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

          <p class="lp-form-h">Get the free guide</p>

          <label class="field"><span>Name <span class="req" aria-hidden="true">*</span></span>
            <input name="name" type="text" autocomplete="name" required aria-required="true" placeholder="First & last" />
          </label>
          <label class="field"><span>Email <span class="req" aria-hidden="true">*</span></span>
            <input name="email" type="email" autocomplete="email" required aria-required="true" placeholder="you@business.com" />
          </label>
          <label class="field"><span>Business name <span class="req" aria-hidden="true">*</span></span>
            <input name="business" type="text" autocomplete="organization" required aria-required="true" placeholder="Your business" />
          </label>
          <label class="field"><span>Annual revenue <span class="req" aria-hidden="true">*</span></span>
            <select name="revenue" required aria-required="true">
              <option value="">Select one</option>
              {revenueOptions.map((o) => <option>{o}</option>)}
            </select>
            <small class="field-help">Helps us send what fits your stage.</small>
          </label>
          <label class="field"><span>Phone <span class="req" aria-hidden="true">*</span></span>
            <input name="phone" type="tel" autocomplete="tel" required aria-required="true" placeholder="(760) 555-0123" />
          </label>

          <!-- Ad attribution (section 2c), filled on submit -->
          <input type="hidden" name="fbclid" />
          <input type="hidden" name="gclid" />
          <input type="hidden" name="fbc" />
          <input type="hidden" name="fbp" />
          <input type="hidden" name="utm_source" />
          <input type="hidden" name="utm_medium" />
          <input type="hidden" name="utm_campaign" />
          <input type="hidden" name="utm_content" />
          <input type="hidden" name="utm_term" />
          <input type="hidden" name="landing_url" />
          <input type="hidden" name="event_id" />
          <input type="hidden" name="gbraid" />
          <input type="hidden" name="wbraid" />
          <input type="hidden" name="first_landing" />
          <input type="hidden" name="referrer" />

          <button type="submit" class="lp-btn">Send me the guide →</button>
          <FormReassurance items={['Free guide', 'No sales call required', 'Unsubscribe anytime']} />
          <p class="lp-error" data-error hidden>Something went wrong. Please try again.</p>
        </form>
      </div>
    </div>
  </section>

  <div id="lp-hero-sentinel" aria-hidden="true"></div>

  <LogoStrip />

  <ProblemCards
    eyebrow="Sound familiar?"
    heading="Marketing keeps landing back on your desk."
    cards={[
      { icon: 'clock', bold: "You're doing it yourself.", text: 'Nights and weekends, between running the business.' },
      { icon: 'split', bold: 'You hired help. You still own the plan.', text: 'The work gets done, but nobody owns the strategy.' },
      { icon: 'user', bold: "You're thinking about a full-time hire.", text: "It's a big salary, and one person can't do it all." },
    ]}
  />

  <AssetPreview
    variant="guide"
    tone="alt"
    bullets={[
      'The fully loaded cost of a San Diego marketing hire, using federal wage data',
      "What agencies usually do (and the part they usually don't)",
      "What a fractional CMO is, and when it's the smarter move",
      'A one-page decision guide: which option fits your stage',
      'Reads in about 8 minutes.',
    ]}
    buttonLabel="Send me the guide →"
    buttonTarget="#form"
  />

  <CompareTable
    heading="Three ways to get marketing help."
    sub="Each one works, for the right stage. The guide shows the real numbers."
  />

  <HowItWorks
    tone="alt"
    steps={[
      'Tell us where to send it (30 seconds).',
      'Read the guide (about 8 minutes).',
      'If you want a second opinion, book a call. No pressure.',
    ]}
  />

  <ProofStats
    heading="What it looks like when marketing has an owner."
    include={['steady-builders', 'coastal-internal-medicine', 'drain-mob', 'peter-grimm']}
  />

  <Testimonials heading="What clients say." layout="row" tone="alt" />

  <FounderBlock tone="base" />

  <FAQ items={faqs} tone="alt" />

  <FinalCTA heading="Know which kind of help you need." buttonLabel="Get the free guide →" target="#form" />

  <StickyMobileCTA label="Get the free guide" target="#form" />
</LandingLayout>

<script>
  import { wireLeadForm } from '../lib/conversion';
  const form = document.getElementById('real-cost-form') as HTMLFormElement | null;
  if (form) wireLeadForm(form, 'real-cost', '/real-cost/thanks');
</script>

<style>
  .lp { max-width: 1120px; margin: 0 auto; padding: 36px 16px 56px; }
  .lp-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 48px; align-items: start; }
  .lp-copy h1 {
    font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; letter-spacing: -0.02em;
    font-size: clamp(34px, 5.4vw, 56px); line-height: 1.04; margin: 14px 0 18px;
  }
  .lp-copy .sub { color: var(--muted); font-size: clamp(17px, 2vw, 20px); line-height: 1.6; max-width: 560px; }
  .inside { margin: 30px 0; }
  .inside-h { font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted-2); font-weight: 700; margin-bottom: 12px; }
  .inside ul { list-style: none; display: grid; gap: 12px; }
  .inside li { color: #e6e8ee; padding-left: 28px; position: relative; font-size: 16px; line-height: 1.5; }
  .inside li::before { content: ""; position: absolute; left: 0; top: 7px; width: 13px; height: 13px; border-radius: 4px; background: var(--grad); }
  .hero-cta-mobile { display: none; }
  .trust { display: flex; flex-wrap: wrap; gap: 10px 22px; margin: 26px 0; }
  .trust span { color: var(--muted); font-size: 14px; display: inline-flex; align-items: center; gap: 9px; }
  .trust span::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--grad); }
  .hero-proof { margin: 22px 0; }
  .who { border-top: 1px solid var(--line); padding-top: 22px; }
  .who p { color: var(--muted); font-size: 15px; line-height: 1.6; max-width: 540px; }
  .who strong { color: #fff; }
  .who a { color: var(--m); font-weight: 600; }

  .lp-formcol { position: sticky; top: 24px; }
  .lp-form {
    background: var(--card); border: 1px solid var(--line-2); border-radius: 16px; padding: 28px;
    display: grid; gap: 14px;
  }
  .lp-form-h { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 700; font-size: 20px; margin-bottom: 4px; }
  .field { display: grid; gap: 6px; font-size: 13px; color: var(--muted); }
  .field em { font-style: normal; opacity: 0.7; }
  .field input, .field select {
    background: #101119; border: 1px solid var(--line-2); border-radius: 10px; color: #f4f5f7;
    padding: 13px 14px; font: 400 15px Inter, system-ui, sans-serif; width: 100%; box-sizing: border-box;
  }
  .field input:focus, .field select:focus { outline: none; border-color: var(--m); }
  .lp-btn {
    margin-top: 6px; background: var(--grad); color: #fff; border: 0; border-radius: 10px;
    padding: 15px 22px; font: 600 16px Inter, system-ui, sans-serif; cursor: pointer; transition: transform 0.15s;
  }
  .lp-btn:hover { transform: translateY(-1px); }
  .lp-btn:disabled { opacity: 0.75; cursor: wait; }
  .lp-btn:disabled::before {
    content: ""; display: inline-block; width: 14px; height: 14px; margin-right: 8px; vertical-align: -2px;
    border: 2px solid rgba(255,255,255,0.5); border-top-color: #fff; border-radius: 50%; animation: lp-spin 0.7s linear infinite;
  }
  @keyframes lp-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .lp-btn:disabled::before { animation: none; } }
  .lp-error { color: #ff7a7a; font-size: 14px; margin-top: 2px; }

  @media (max-width: 860px) {
    .lp-grid { grid-template-columns: 1fr; gap: 28px; }
    .lp-formcol { position: static; }
    .hero-cta-mobile {
      display: inline-block; background: var(--grad); color: #fff; border-radius: 10px;
      padding: 14px 24px; font: 600 16px Inter, system-ui, sans-serif; margin-top: 4px;
    }
  }
</style>
