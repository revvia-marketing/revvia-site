# ─────────────────────────────────────────────────────────────
# Revvia site — environment variables
# Copy to `.env` for local dev. In production set these in the
# Netlify dashboard (Site settings → Environment variables).
# Anything prefixed PUBLIC_ is exposed to the browser by design.
# ─────────────────────────────────────────────────────────────

# Canonical site URL. Only override if the host/domain changes.
PUBLIC_SITE_URL="https://revvia.com"

# Analytics — leave blank in dev so no beacons fire locally.
# GA4 Measurement ID for the revvia.com property (NOT a client property).
PUBLIC_GA4_ID=""            # e.g. G-XXXXXXXXXX
# Meta (Facebook) Pixel ID for the agency site.
PUBLIC_META_PIXEL_ID=""     # e.g. 1234567890123456
# Google Ads account id (loads on gtag.js alongside GA4).
PUBLIC_GOOGLE_ADS_ID=""     # e.g. AW-XXXXXXXXX

# Google Ads conversion labels — the string AFTER the slash in a conversion's
# send_to (AW-XXXXXXXXX/<label>). Create the conversion actions in the Revvia
# Ads account (Submit lead form · Count: One), then paste each label here.
PUBLIC_GADS_LABEL_REAL_COST=""     # "Lead – Real Cost Guide"
PUBLIC_GADS_LABEL_SCORECARD=""     # "Lead – Scorecard"
PUBLIC_GADS_LABEL_AI_SNAPSHOT=""   # "Lead – AI Snapshot Request"
# One action for every in-page sales form (Growth Audit, AI Visibility Audit,
# GEO scorecard + contact). The form name still separates them in GA4 + the sheet.
PUBLIC_GADS_LABEL_CONTACT=""       # "Lead – Contact Form"
# Optional: fires when an AI Snapshot Zoom is actually booked on Calendly.
PUBLIC_GADS_LABEL_SNAPSHOT_BOOKED=""

# AI Snapshot scheduler (Calendly inline embed URL for the 30-min call).
PUBLIC_SNAPSHOT_BOOKING_URL=""   # e.g. https://calendly.com/revvia/ai-snapshot

# ── Lead auto-responder (netlify/functions/submission-created.mjs) ──
# Server-side ONLY (no PUBLIC_ prefix) - never exposed to the browser.
# SendGrid API key. Authenticate the revvia.com domain in SendGrid first
# (Settings -> Sender Authentication) so mail sends from your address.
SENDGRID_API_KEY=""              # secret - paste in Netlify, not in the repo
FROM_EMAIL="tim@revvia.com"      # must be on a SendGrid-authenticated domain
# "Book a call" link for the guide + scorecard emails. Defaults to the snapshot
# Calendly, then to /contact, if unset.
BOOKING_URL=""                   # e.g. https://calendly.com/revvia/intro-call
# Meta Conversions API (server-side Lead, deduped with the Pixel by event_id).
# Events Manager -> the Revvia dataset -> Settings -> Generate access token.
META_CAPI_TOKEN=""               # secret - paste in Netlify, not in the repo
META_TEST_EVENT_CODE=""          # optional, only while testing (Events Manager -> Test events)

# ── Keystatic (GitHub mode) ──────────────────────────────────
# The repo Keystatic commits to is hard-coded in keystatic.config.tsx
# (revvia-marketing/revvia-site), so no repo env var is needed.
# In production these four power the GitHub App login at /keystatic.
# In `astro dev` Keystatic uses local mode, so they're optional locally.
#
# The first three (CLIENT_ID, CLIENT_SECRET, APP_SLUG) are produced when you
# run the "Create GitHub App" flow at https://<your-site>/keystatic. The
# GitHub App's OAuth callback URL must be:
#   https://<your-site>/api/keystatic/github/oauth/callback
KEYSTATIC_GITHUB_CLIENT_ID=""              # from the GitHub App
KEYSTATIC_GITHUB_CLIENT_SECRET=""          # from the GitHub App
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=""        # the GitHub App's slug (github.com/apps/<slug>)
KEYSTATIC_SECRET=""                        # random 32-byte hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── Lead pipeline (configured in dashboards, NOT committed) ──
# Netlify Forms notification email is set in the Netlify UI
# (Forms → Form notifications → email Jan + Tim). No env needed.
# Google Sheet sync: Netlify Forms -> outgoing webhook (Forms ->
# Submission notifications) -> the Apps Script web app bound to the
# "Revvia Lead Ledger" sheet. The webhook URL lives in Netlify only,
# never in the repo.

# ── AI Visibility instant check ──────────────────────────────
# The check stays in the email fallback until CHECK_ENABLED=true AND every
# key below is non-empty. Confirm the model slugs before spending money.
# Docs checked 2026-10-27:
#   OpenAI web search: https://developers.openai.com/api/docs/guides/tools-web-search
#     (docs example model: gpt-6-astra)
#   Perplexity Sonar chat completions still work; Agent API is the successor:
#     https://docs.perplexity.ai/docs/agent-api/migrate-from-sonar/overview
#     (docs example model: sonar)
#   Anthropic web search: https://platform.claude.com/docs/en/agents-and-tools/tool-use/web-search-tool
#     (docs example model: claude-opus-5-5)
# Netlify plan must include Background Functions and Blobs. Unverified here.
CHECK_ENABLED="false"
OPENAI_API_KEY=""
OPENAI_MODEL=""                 # e.g. the current web-search model you approve
PERPLEXITY_API_KEY=""
PERPLEXITY_MODEL=""             # e.g. sonar
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""              # e.g. the current Claude model you approve
PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
CHECK_IP_SALT=""                # long random string; never reuse a secret
CHECK_DAILY_CAP="200"
CHECK_CACHE_TTL_HOURS="24"
CHECK_CALL_TIMEOUT_MS="25000"
# Optional. Read-only Stripe key limited to Promotion Codes Read.
# Leave blank to keep the static "first 10 founding clients" line.
STRIPE_RESTRICTED_KEY_READ=""
FOUNDING_PROMO_CODE="FOUNDING10"
# Public Payment Links. These defaults are also in code.
PUBLIC_STRIPE_LINK_KEEP="https://buy.stripe.com/5kQ4gzcOH2ri4yP8WQ0kE0M"
PUBLIC_STRIPE_LINK_GROW="https://buy.stripe.com/8x2bJ17un3vm2qHeha0kE0N"
# Used only by the billing-link design in docs/billing-link.md. Not called by the site.
BILLING_LINK_SECRET=""
